generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  OWNER
  OPERATOR
}

enum CameraType {
  FILE
  WEBCAM
  RTSP
}

model Tenant {
  id        String       @id @default(uuid()) @db.Uuid
  slug      String       @unique @db.VarChar(80)
  name      String       @db.VarChar(120)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  users     User[]
  sites     Site[]
  audits    AuditEntry[]
}

model User {
  id           String       @id @default(uuid()) @db.Uuid
  tenantId     String       @db.Uuid
  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  email        String       @unique @db.VarChar(254)
  passwordHash String
  role         Role
  active       Boolean      @default(true)
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  sessions     Session[]
  audits       AuditEntry[]

  @@unique([tenantId, id])
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  userId    String    @db.Uuid
  user      User      @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Restrict)
  tokenHash String    @unique @db.Char(64)
  expiresAt DateTime  @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@index([tenantId, userId, expiresAt])
}

model Site {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @db.Uuid
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  name         String   @db.VarChar(120)
  timezone     String   @db.VarChar(80)
  bootstrapKey String?  @db.VarChar(40)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  cameras      Camera[]

  @@unique([tenantId, id])
  @@unique([tenantId, bootstrapKey])
  @@index([tenantId, createdAt, id])
}

model Camera {
  id              String     @id @default(uuid()) @db.Uuid
  tenantId        String     @db.Uuid
  siteId          String     @db.Uuid
  site            Site       @relation(fields: [tenantId, siteId], references: [tenantId, id], onDelete: Restrict)
  name            String     @db.VarChar(120)
  type            CameraType
  expectedRunning Boolean    @default(false)
  createdAt       DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @db.Timestamptz(3)
  device          Device?

  @@unique([tenantId, id])
  @@index([tenantId, createdAt, id])
}

model Device {
  id                String             @id @default(uuid()) @db.Uuid
  tenantId          String             @db.Uuid
  cameraId          String             @unique @db.Uuid
  camera            Camera             @relation(fields: [tenantId, cameraId], references: [tenantId, id], onDelete: Restrict)
  credentialVersion Int                @default(0)
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  credentials       DeviceCredential[]

  @@unique([tenantId, id])
  @@unique([tenantId, cameraId])
}

model DeviceCredential {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @db.Uuid
  deviceId  String    @db.Uuid
  device    Device    @relation(fields: [tenantId, deviceId], references: [tenantId, id], onDelete: Restrict)
  tokenHash String    @unique @db.Char(64)
  version   Int
  revokedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @db.Timestamptz(3)

  @@unique([tenantId, deviceId, version])
}

model AuditEntry {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @db.Uuid
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actorId   String?  @db.Uuid
  actor     User?    @relation(fields: [tenantId, actorId], references: [tenantId, id], onDelete: Restrict)
  action    String   @db.VarChar(60)
  objectId  String?  @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@index([tenantId, createdAt, id])
}
