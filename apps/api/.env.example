API_HOST=127.0.0.1
API_PORT=3001
DATABASE_URL=
WEB_ORIGIN=http://127.0.0.1:3000
NODE_ENV=development
ALLOW_INSECURE_LOCAL_HTTP=true
# O setup:env deriva DATABASE_URL do .env raiz sem imprimir a senha.
# Opcional: preencher privadamente ou usar pnpm.cmd setup:owner.
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_TENANT_SLUG=demo
BOOTSTRAP_TENANT_NAME=Bancada Radar
BOOTSTRAP_SITE_NAME=Local de demonstração
BOOTSTRAP_SITE_TIMEZONE=America/Sao_Paulo
