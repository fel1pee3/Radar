  "info": {
    "title": "Radar de Acontecimentos — API local",
    "description": "",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "human-session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "radar_session"
      },
      "worker-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 1,
            "maxLength": 128,
            "writeOnly": true
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "Object": {
        "type": "object",
        "properties": {}
      },
      "SiteDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "timezone": {
            "type": "string",
            "example": "America/Sao_Paulo"
          }
        },
        "required": [
          "name",
          "timezone"
        ]
      },
      "SitePatchDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "timezone": {
            "type": "string",
            "example": "America/Sao_Paulo"
          }
        }
      },
      "CameraDto": {
        "type": "object",
        "properties": {
          "siteId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "type": {
            "type": "string",
            "enum": [
              "FILE",
              "WEBCAM",
              "RTSP"
            ]
          },
          "expectedRunning": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "siteId",
          "name",
          "type"
        ]
      },
      "CameraPatchDto": {
        "type": "object",
        "properties": {
          "siteId": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "type": {
            "type": "string",
            "enum": [
              "FILE",
              "WEBCAM",
              "RTSP"
            ]
          },
          "expectedRunning": {
            "type": "boolean",
            "default": false
          }
        }
      }
    }
  }
