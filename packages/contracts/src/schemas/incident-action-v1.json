          "const": "DISMISS"
        },
        "reason": {
          "type": "string",
          "enum": ["FALSE_DETECTION", "TEST_EVENT", "DUPLICATE", "OTHER"]
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        }
      },
      "required": ["actionId", "expectedVersion", "action", "reason"],
      "allOf": [
        {
          "if": {
            "properties": {
              "reason": {
                "const": "OTHER"
              }
            },
            "required": ["reason"]
          },
          "then": {
            "required": ["note"]
          }
        }
      ]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "expectedVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "action": {
          "type": "string",
          "const": "ADD_NOTE"
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        }
      },
      "required": ["actionId", "expectedVersion", "action", "note"]
    }
