          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "expectedVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "action": {
          "type": "string",
          "const": "SET_REVIEW"
        },
        "review": {
          "type": "string",
          "enum": [
            "UNREVIEWED",
            "PERSON_ON_FLOOR_CONFIRMED",
            "FALL_REPORTED",
            "FALSE_POSITIVE",
            "INCONCLUSIVE"
          ]
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "pattern": "\\S"
        }
      },
      "required": ["actionId", "expectedVersion", "action", "review"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "expectedVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "action": {
          "type": "string",
          "const": "RESOLVE"
        },
        "review": {
          "type": "string",
          "enum": ["PERSON_ON_FLOOR_CONFIRMED", "FALL_REPORTED", "FALSE_POSITIVE", "INCONCLUSIVE"]
        },
        "outcome": {
          "type": "string",
          "enum": ["ASSISTANCE_RECORDED", "NO_ASSISTANCE_NEEDED", "INCONCLUSIVE", "TEST_COMPLETED"]
        }
      },
      "required": ["actionId", "expectedVersion", "action", "review", "outcome"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "expectedVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
