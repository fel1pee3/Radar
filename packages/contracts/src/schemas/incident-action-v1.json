{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://radar.local/contracts/incident-action-v1.json",
  "title": "IncidentActionV1",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "expectedVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "action": {
          "type": "string",
          "const": "RECOGNIZE"
        }
      },
      "required": ["actionId", "expectedVersion", "action"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "actionId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
        },
        "expectedVersion": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "action": {
          "type": "string",
          "const": "START_RESPONSE"
        }
      },
      "required": ["actionId", "expectedVersion", "action"]
    },
    {
      "type": "object",
      "additionalProperties": false,
